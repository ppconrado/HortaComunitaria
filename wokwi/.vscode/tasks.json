{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar firmware Wokwi",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/compile.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Rodar Wokwi CLI",
            "type": "shell",
            "command": "wokwi-cli .",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Compilar firmware Wokwi",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
